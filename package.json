{
  "name": "hyperfamily-branch-monitor",
  "version": "3.1.7",
  "private": true,
  "description": "Secure Windows desktop monitoring and inventory application for HyperFamily retail branches.",
  "author": "Ali Ajeli Lahiji",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n NEXT,ELECTRON -c cyan,magenta \"npm:dev:next\" \"npm:dev:electron\"",
    "dev:next": "next dev -H 0.0.0.0",
    "dev:electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build": "next build",
    "build:electron": "npm run build:agent && npm run build && electron-builder --config electron-builder.json",
    "start": "electron .",
    "recovery": "electron . --recovery",
    "lint": "eslint .",
    "test": "node --test tests/version.test.js tests/changelog.test.js tests/update-channel.test.js tests/software-service.test.js tests/store-update-service.test.js tests/registry-service.test.js tests/wmi-registry-service.test.js tests/store-agent-service.test.js tests/agent-transfer-service.test.js tests/native-agent-binary.test.js tests/about-metadata.test.js tests/store-install-service.test.js",
    "test:database": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/database.electron-test.js",
    "test:ssh": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/ssh-kex.electron-test.js",
    "test:vpn": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/vpn-connect.electron-test.js",
    "test:template": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/import-template.electron-test.js",
    "format": "prettier --write .",
    "postinstall": "electron-builder install-app-deps",
    "build:recovery": "npm --prefix electron/recovery install && electron-builder --config electron-builder.recovery.json --publish never",
    "build:agent": "node electron/scripts/build-agent.js",
    "test:agent": "node --test tests/agent-windows.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "ssh2": "^1.17.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@formkit/auto-animate": "^0.8.2",
    "@hookform/resolvers": "^3.10.0",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.23",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.23",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^3.10.1",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "vaul": "^1.1.2",
    "wait-on": "^8.0.2",
    "zod": "^3.24.1",
    "zustand": "^4.5.6"
  }
}
