{
  "appId": "com.hyperfamily.branchmonitor",
  "productName": "HyperFamily Branch Monitor",
  "asar": true,
  "compression": "maximum",
  "afterPack": "electron/scripts/after-pack.cjs",
  "asarUnpack": [
    "node_modules/better-sqlite3-multiple-ciphers/**/*",
    "node_modules/keytar/**/*",
    "node_modules/ssh2/**/*",
    "node_modules/cpu-features/**/*"
  ],
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "!electron/recovery/node_modules/**",
    "!electron/recovery/package.json",
    "!electron/recovery/package-lock.json",
    "out/**/*",
    "public/**/*",
    "package.json",
    "node_modules/**/*",
    "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/*.node",
    "node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-x64.node",
    "!node_modules/exceljs/dist/**",
    "!node_modules/keytar/prebuilds/{darwin,linux,linuxmusl,win32-arm64}*.node",
    "!node_modules/cpu-features/prebuilds/{darwin,linux,linuxmusl,win32-arm64}*.node",
    "!node_modules/**/*.map",
    "!node_modules/**/*.d.ts",
    "!node_modules/**/*.md"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/electron/icon.ico",
    "artifactName": "HyperFamily-Branch-Monitor-Setup-${version}.${ext}",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "runAfterFinish": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "differentialPackage": true,
    "installerIcon": "public/electron/icon.ico",
    "uninstallerIcon": "public/electron/icon.ico"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "aliajeli",
      "repo": "hyperfamily-it-app",
      "releaseType": "release"
    }
  ],
  "extraResources": [
    {
      "from": "agent/build/HyperFamilyStoreAgent.exe",
      "to": "agent/HyperFamilyStoreAgent.exe"
    }
  ]
}
